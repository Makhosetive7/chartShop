TELEGRAM_BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZ_dummy_token
TELEGRAM_WEBHOOK_SECRET=replace_with_long_random_hex
MONGODB_URI=mongodb+srv://dummy_user:dummy_password@dummycluster.mongodb.net/dummydb
PORT=3000
NODE_ENV=development
USE_POLLING=true
WEBHOOK_URL=https://dummy-app.up.railway.app/webhook/telegram
RAILWAY_STATIC_URL=dummy-app.up.railway.app
# Web dashboard origin (Vite default). Use * for local-only if preferred.
CORS_ORIGIN=http://localhost:5173

# WhatsApp Cloud API (optional — set WHATSAPP_ENABLED=true to turn on)
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=replace_with_meta_permanent_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_phone_number_id
WHATSAPP_VERIFY_TOKEN=replace_with_verify_token
WHATSAPP_APP_SECRET=required_for_webhook_signature_verification

# Security Configuration (REQUIRED in production)
RECOVERY_CODE_PEPPER=replace_with_unique_64_character_random_string_per_deployment
SESSION_SECRET=replace_with_unique_64_character_random_string_for_sessions
CRON_SECRET=replace_with_unique_32_character_random_string_for_cron_jobs
