{
  "name": "chartshop-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:dev": "NODE_ENV=development node server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "dev": "NODE_ENV=development nodemon server.js",
    "prod": "NODE_ENV=production nodemon server.js",
    "deploy": "node scripts/setWebhook.js",
    "test": "node --test tests/**/*.test.js",
    "test:phase4": "node --test tests/**/*.test.js",
    "job:credit-due": "node scripts/runCreditDueReminders.js",
    "seed:boutique": "node --env-file=.env scripts/seedBoutiqueDemo.js",
    "seed:demos": "node --env-file=.env scripts/seedSectorDemos.js",
    "seed:demos:prod": "node --env-file=.env.production scripts/seedSectorDemos.js",
    "seed:test": "node --env-file=.env scripts/seedTestNotifications.js",
    "migrate:users": "node --env-file=.env scripts/migrateUsersFromShops.js"
  },
  "dependencies": {
    "axios": "^1.5.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^11.0.0",
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "pdfkit": "^0.14.0",
    "telegraf": "^4.12.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
